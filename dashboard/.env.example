NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the VERDANT backend API (provider keys, etc.)
NEXT_PUBLIC_API_URL=https://verdant-be.onrender.com

# Server-only VERDANT API key used by the dashboard's read pages
# (overview / audits / reports) to fetch live audit data from the API.
# Generate one in the app under Settings -> API keys. Do NOT prefix with
# NEXT_PUBLIC_ — it must stay server-side and never reach the browser.
VERDANT_API_KEY=
# Optional: override the API URL used for those server-side reads
# (defaults to NEXT_PUBLIC_API_URL, then the hosted API).
# VERDANT_API_URL=https://verdant-be.onrender.com
